---
import mobilePortrait from "../../assets/gary-virk-portrait.webp?url";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilities, education, experience, profile } from "../data/site";
import { flagshipProjects, supportingProjects } from "../data/projects";
import "../styles/portrait-home.css";

const homepageSupportingSlugs = [
  "endpoint-deployment-rollback",
  "dhcp-failure-isolation",
  "smb-share-access",
  "packet-triage-library"
];
const homepageSupportingProjects = homepageSupportingSlugs.flatMap((slug) => {
  const project = supportingProjects.find((candidate) => candidate.slug === slug);
  return project ? [project] : [];
});
---

<BaseLayout
  title={`Gary Virk | ${profile.role}`}
  description="Gary Virk is an IT specialist in Mississauga with hands-on experience across endpoints, hardware, deployments, ticket documentation, and network troubleshooting."
  bodyClass="profile-page"
  themeColor="#080a0c"
  colorScheme="dark"
>
  <header class="profile-header">
    <a class="profile-brand" href="#about" aria-label="Gary Virk, about">
      <strong>Gary Virk</strong>
    </a>
    <nav class="profile-nav" aria-label="Primary navigation">
      <a href="/work.html">Work</a>
      <a href="#experience">Experience</a>
      <a href="/resume.html">Résumé</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="header-email" href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="profile-hero" id="about" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-role">{profile.name} · {profile.role}</p>
        <h1 id="hero-title">{profile.focus}</h1>
        <p class="hero-story">{profile.introduction}</p>

        <div class="hero-actions">
          <a class="profile-button profile-button--light" href="/work.html">
            View case studies <span aria-hidden="true">↗</span>
          </a>
          <a class="profile-button profile-button--quiet" href="/resume.html">
            View résumé <span aria-hidden="true">→</span>
          </a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Location</dt>
            <dd>{profile.shortLocation}</dd>
          </div>
          <div>
            <dt>Background</dt>
            <dd>Field service and end-user support</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Windows endpoints and networks</dd>
          </div>
        </dl>
      </div>

      <figure class="hero-portrait" data-portrait>
        <img
          src={mobilePortrait}
          alt="Black-and-white portrait of Gary Virk"
          width="900"
          height="1350"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <span class="portrait-light" aria-hidden="true"></span>
      </figure>
    </section>

    <section class="profile-section selected-work" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="section-index">Selected work</p>
        <div>
          <h2 id="work-title">How I troubleshoot and verify a fix.</h2>
          <p>
            Each case shows the fault, the check that narrowed it down, the correction,
            and a separate retest. Private details are removed from the published lab
            output.
          </p>
        </div>
      </div>

      <div class="flagship-grid">
        {
          flagshipProjects.map((project) => (
            <article class="project-card">
              <div class="project-card-meta">
                <span>{project.number}</span>
                <p>{project.status.execution}</p>
              </div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <strong>{project.employerValue}</strong>
              <a href={`/work/${project.slug}.html`}>
                Read the case <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>

      <div class="supporting-row">
        <p>Supporting labs</p>
        {
          homepageSupportingProjects.map((project) => (
            <a href={`/work/${project.slug}.html`}>
              <span>{project.number}</span>
              <strong>{project.title}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
        <a href="/work.html">
          <span>All</span>
          <strong>View all work</strong>
          <i aria-hidden="true">→</i>
        </a>
      </div>
    </section>

    <section class="profile-section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="section-index">Experience</p>
        <div>
          <h2 id="experience-title">On-site support experience.</h2>
          <p>
            My on-site work has included Windows endpoints, Dell hardware, software,
            deployments, ServiceNow records, and device-level connectivity problems.
          </p>
        </div>
      </div>

      <div class="experience-list">
        {
          experience.map((job) => (
            <article>
              <div class="experience-title">
                <h3>{job.role}</h3>
                <p>
                  {job.company}
                  {job.assignment && <span> · {job.assignment}</span>}
                </p>
              </div>
              <p class="experience-period">{job.period}<br />{job.location}</p>
              <p>{job.summary}</p>
            </article>
          ))
        }
      </div>

      <div class="education-strip">
        <p>Education</p>
        {
          education.map((item) => (
            <div>
              <strong>{item.program}</strong>
              <span>{item.school} · {item.location}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="profile-section skills-section" id="skills" aria-labelledby="skills-title">
      <div class="section-heading">
        <p class="section-index">Skills</p>
        <div>
          <h2 id="skills-title">Tools and systems I have worked with.</h2>
          <p>
            This list combines hands-on support work, formal training, and skills
            demonstrated in the labs on this site.
          </p>
        </div>
      </div>

      <div class="skills-grid">
        {
          capabilities.map((capability) => (
            <article>
              <span>{capability.number}</span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <p class="section-index">Contact</p>
      <div class="contact-intro">
        <div class="contact-copy">
          <h2 id="contact-title">Have an IT support or networking role in mind?</h2>
          <p>
            I’m based in Mississauga, Ontario. Use the form below or email me directly
            about IT support and networking roles.
          </p>
        </div>

        <div class="contact-recipient">
          <p>To</p>
          <div class="contact-actions">
            <a class="contact-email" href={`mailto:${profile.email}`}>
              <span>Email me directly</span>
              <strong>{profile.email}</strong>
            </a>
            <button class="copy-email" type="button" data-copy-email={profile.email}>
              Copy
            </button>
          </div>
          <span class="copy-status" data-copy-status aria-live="polite"></span>
        </div>

        <nav class="contact-links" aria-label="Contact links">
          <a href={profile.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="/resume.html">Résumé <span aria-hidden="true">↗</span></a>
          <a href="/work.html">Selected work <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <form
        class="contact-form"
        action={`https://formsubmit.co/${profile.email}`}
        method="POST"
        enctype="multipart/form-data"
        data-contact-form
      >
        <input type="hidden" name="_subject" value="New message from garyvirk.com" />
        <input type="hidden" name="_next" value="https://garyvirk.com/message-sent.html" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_url" value="https://garyvirk.com/#contact" />
        <label class="contact-honey" aria-hidden="true">
          Website
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </label>

        <div class="contact-form-heading">
          <p>Message</p>
          <span>Required fields are marked.</span>
        </div>

        <div class="contact-form-grid">
          <label class="contact-field">
            <span>First name <i>Required</i></span>
            <input
              type="text"
              name="first_name"
              autocomplete="given-name"
              maxlength="60"
              required
            />
          </label>

          <label class="contact-field">
            <span>Last name <i>Required</i></span>
            <input
              type="text"
              name="last_name"
              autocomplete="family-name"
              maxlength="60"
              required
            />
          </label>

          <label class="contact-field contact-field--full">
            <span>Your email <i>Required</i></span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              maxlength="160"
              required
            />
          </label>

          <label class="contact-field contact-field--full">
            <span>Message <i>Required</i></span>
            <textarea
              name="message"
              rows="6"
              minlength="20"
              maxlength="2000"
              aria-describedby="message-count"
              required
              data-contact-message
            ></textarea>
            <small id="message-count" data-contact-message-count>0 / 2000</small>
          </label>

          <label class="contact-field contact-field--full contact-file">
            <span>Attachment <i>Optional</i></span>
            <input
              type="file"
              name="attachment"
              accept=".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg"
              aria-describedby="attachment-help attachment-status"
              data-contact-file
            />
            <small id="attachment-help">PDF, DOC, DOCX, TXT, PNG, or JPG. Maximum 10 MB.</small>
            <small id="attachment-status" data-contact-file-status aria-live="polite"></small>
          </label>
        </div>

        <div class="contact-form-footer">
          <p class="contact-privacy">
            This form is processed by FormSubmit. For a direct message, email
            {` ${profile.email}`}. Do not include passwords or sensitive personal
            information.
            <a href="https://formsubmit.co/privacy.pdf" rel="noopener noreferrer">
              Privacy details <span aria-hidden="true">↗</span>
            </a>
          </p>
          <button class="contact-submit" type="submit" data-contact-submit>
            <span data-contact-submit-label>Send message</span>
            <i aria-hidden="true">↗</i>
          </button>
        </div>

        <p class="contact-form-status" data-contact-form-status aria-live="polite"></p>
        <a
          class="contact-form-fallback"
          href={`mailto:${profile.email}`}
          data-contact-fallback
          hidden
        >
          Open this message in your email app <span aria-hidden="true">↗</span>
        </a>
        <p class="contact-fallback-note" data-contact-fallback-note hidden></p>
      </form>

      <p class="contact-signoff">Gary Virk · Mississauga, Ontario, Canada</p>
    </section>
  </main>

  <script src="../scripts/portrait-home.ts"></script>
</BaseLayout>
