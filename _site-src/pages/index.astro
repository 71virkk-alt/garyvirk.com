---
import heroPortrait from "../../assets/gary-virk-hero.webp?url";
import mobilePortrait from "../../assets/gary-virk-portrait.webp?url";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilities, credentials, education, experience, profile } from "../data/site";
import { flagshipProjects, supportingProjects } from "../data/projects";
import "../styles/portrait-home.css";
---

<BaseLayout
  title="Gary Virk | IT Support Technician"
  description="Gary Virk is an IT support technician in Mississauga focused on Windows endpoints, user support, ticket documentation, and network troubleshooting."
  bodyClass="profile-page"
  themeColor="#080a0c"
  colorScheme="dark"
>
  <header class="profile-header">
    <a class="profile-brand" href="#about" aria-label="Gary Virk, about">
      <strong>Gary Virk</strong>
      <span>IT support technician</span>
    </a>
    <nav class="profile-nav" aria-label="Primary navigation">
      <a href="#about">About</a>
      <a href="/work.html">Work</a>
      <a href="#experience">Experience</a>
      <a href="/resume.html">Résumé</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="header-email" href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="profile-hero" id="about" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="section-index"><span>01</span> About</p>
        <p class="hero-role">{profile.role}</p>
        <h1 id="hero-title">{profile.focus}</h1>
        <p class="hero-story">{profile.introduction}</p>

        <div class="hero-actions">
          <a class="profile-button profile-button--light" href="/work.html">
            View selected work <span aria-hidden="true">↗</span>
          </a>
          <a class="profile-button profile-button--quiet" href="/resume.html">
            View résumé <span aria-hidden="true">→</span>
          </a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Based in</dt>
            <dd>{profile.shortLocation}</dd>
          </div>
          <div>
            <dt>Work</dt>
            <dd>On-site IT support</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Windows and networks</dd>
          </div>
        </dl>
      </div>

      <figure class="hero-portrait" data-portrait>
        <picture>
          <source media="(max-width: 760px)" srcset={mobilePortrait} />
          <img
            src={heroPortrait}
            alt="Black-and-white portrait of Gary Virk"
            width="1440"
            height="960"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <span class="portrait-light" aria-hidden="true"></span>
      </figure>
    </section>

    <section class="profile-section selected-work" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="section-index"><span>02</span> Selected work</p>
        <div>
          <h2 id="work-title">The problem, the check, and what happened next.</h2>
          <p>
            These controlled labs show the evidence I used to isolate a fault, the
            correction I made, and the separate check that confirmed the result.
          </p>
        </div>
      </div>

      <div class="flagship-grid">
        {
          flagshipProjects.map((project) => (
            <article class="project-card">
              <div class="project-card-meta">
                <span>{project.number}</span>
                <p>{project.status.execution}</p>
              </div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <strong>{project.employerValue}</strong>
              <a href={`/work/${project.slug}.html`}>
                Read the case <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }
      </div>

      <div class="supporting-row">
        <p>Supporting labs</p>
        {
          supportingProjects.map((project) => (
            <a href={`/work/${project.slug}.html`}>
              <span>{project.number}</span>
              <strong>{project.title}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="profile-section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="section-index"><span>03</span> Experience</p>
        <div>
          <h2 id="experience-title">Support work shaped by the person at the other end.</h2>
          <p>
            My background is hands-on and user-facing. I work from the symptom, keep the
            ticket current, and make the escalation useful when the issue needs another team.
          </p>
        </div>
      </div>

      <div class="experience-list">
        {
          experience.map((job) => (
            <article>
              <div class="experience-title">
                <h3>{job.role}</h3>
                <p>
                  {job.company}
                  {job.assignment && <span> · {job.assignment}</span>}
                </p>
              </div>
              <p class="experience-period">{job.period}<br />{job.location}</p>
              <p>{job.summary}</p>
            </article>
          ))
        }
      </div>

      <div class="education-strip">
        <p>Education</p>
        {
          education.map((item) => (
            <div>
              <strong>{item.program}</strong>
              <span>{item.school} · {item.location}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="profile-section skills-section" id="credentials" aria-labelledby="skills-title">
      <div class="section-heading">
        <p class="section-index"><span>04</span> Skills and credentials</p>
        <div>
          <h2 id="skills-title">Useful range, tied to recognizable support work.</h2>
          <p>
            The categories below describe work I can discuss in an interview. The project
            pages show where a lab provides direct evidence.
          </p>
        </div>
      </div>

      <div class="skills-grid">
        {
          capabilities.map((capability) => (
            <article>
              <span>{capability.number}</span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </article>
          ))
        }
      </div>

      <div class="credential-row">
        {
          credentials.map((credential) => (
            <div>
              <strong>{credential.name}</strong>
              <span>{credential.detail}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <p class="section-index"><span>05</span> Contact</p>
      <div class="contact-copy">
        <h2 id="contact-title">If the role needs careful support work, I would like to hear about it.</h2>
        <p>{profile.shortLocation} · Open to IT support and network-support opportunities.</p>
      </div>
      <div class="contact-actions">
        <a class="contact-email" href={`mailto:${profile.email}`}>
          <span>Email me</span>
          <strong>{profile.email}</strong>
        </a>
        <button class="copy-email" type="button" data-copy-email={profile.email}>
          Copy
        </button>
        <span class="copy-status" data-copy-status aria-live="polite"></span>
      </div>
      <nav class="contact-links" aria-label="Contact links">
        <a href={profile.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="/resume.html">Résumé <span aria-hidden="true">↗</span></a>
        <a href="/work.html">Selected work <span aria-hidden="true">↗</span></a>
      </nav>
      <p class="contact-signoff">Gary Virk · Mississauga, Ontario, Canada</p>
    </section>
  </main>

  <script src="../scripts/portrait-home.ts"></script>
</BaseLayout>
