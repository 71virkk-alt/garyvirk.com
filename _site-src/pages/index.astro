---
import heroPortrait from "../../assets/gary-virk-hero.webp?url";
import mobilePortrait from "../../assets/gary-virk-portrait.webp?url";
import resumePdf from "../../assets/Gary-Virk-Resume.pdf?url";
import BaseLayout from "../layouts/BaseLayout.astro";
import { capabilities, credentials, experience, profile } from "../data/site";
import "../styles/portrait-home.css";

const primaryCredentials = credentials.slice(0, 3);
---

<BaseLayout
  title="Gary Virk — IT Support & Network Infrastructure"
  description="Gary Virk is an IT support and network infrastructure specialist in Mississauga, Ontario, with hands-on enterprise experience across endpoints, identity, networks, and documentation."
  bodyClass="portrait-site"
  themeColor="#080a0c"
  colorScheme="dark"
>
  <main class="portfolio-shell" id="main" data-portfolio-shell data-active-view="about">
    <header class="portrait-header">
      <a class="portrait-brand" href="/" aria-label="Gary Virk, homepage">
        <span>Gary Virk</span>
        <small>IT support / infrastructure</small>
      </a>

      <nav class="portrait-nav" aria-label="Portfolio sections" data-view-navigation>
        <button type="button" data-view-target="about" aria-current="page">
          <span>01</span> About
        </button>
        <button type="button" data-view-target="work">
          <span>02</span> Work / lab
        </button>
        <button type="button" data-view-target="experience">
          <span>03</span> Experience
        </button>
        <button type="button" data-view-target="credentials">
          <span>04</span> Credentials
        </button>
        <a href="/resume.html"><span>05</span> Résumé</a>
      </nav>

      <a class="portrait-email" href={`mailto:${profile.email}`}>
        <span>Email</span>
        <strong>{profile.email}</strong>
        <i aria-hidden="true">↗</i>
      </a>
    </header>

    <div class="portrait-stage">
      <section class="view-stage" aria-label="Portfolio introduction" aria-live="polite">
        <article class="view-panel view-panel--about" data-view-panel="about" data-active>
          <p class="view-index"><span>01</span> About</p>
          <h1>Hello, I’m Gary.</h1>
          <p class="view-intro">
            I support the systems people rely on—endpoints, identity, networks, and the
            documentation that makes the next issue easier to solve.
          </p>

          <div class="about-facts" aria-label="Professional summary">
            <p><span>Based in</span>Mississauga, Ontario</p>
            <p><span>Experience</span>Nearly 3 years</p>
            <p><span>Focus</span>Support & infrastructure</p>
          </div>

          <div class="view-actions">
            <a class="primary-action" href={`mailto:${profile.email}`}>
              Start a conversation <span aria-hidden="true">↗</span>
            </a>
            <a class="quiet-action" href={resumePdf} download="Gary-Virk-Resume.pdf">
              Download résumé
            </a>
          </div>
        </article>

        <article class="view-panel view-panel--work" data-view-panel="work" aria-hidden="true" inert>
          <p class="view-index"><span>02</span> Work / lab</p>
          <h2>Show the checks.<br />Not just the claim.</h2>
          <p class="view-intro">
            My lab work turns a troubleshooting story into inspectable evidence: topology,
            commands, system output, resolution, and validation.
          </p>

          <div class="featured-record">
            <div>
              <p><i aria-hidden="true"></i> Case 001 · In progress</p>
              <h3>Windows Server identity troubleshooting</h3>
            </div>
            <ul aria-label="Case study scope">
              <li>AD DS / DNS / DHCP</li>
              <li>Group Policy</li>
              <li>Event logs</li>
              <li>PowerShell checks</li>
            </ul>
          </div>

          <p class="view-note">
            The full case opens on its own page only when every artifact is complete and safe to
            publish.
          </p>
        </article>

        <article
          class="view-panel view-panel--experience"
          data-view-panel="experience"
          aria-hidden="true"
          inert
        >
          <p class="view-index"><span>03</span> Experience</p>
          <h2>Support work in<br />live environments.</h2>

          <div class="role-list">
            {
              experience.map((job, index) => (
                <article>
                  <p class="role-number">0{index + 1}</p>
                  <div>
                    <h3>{job.role}</h3>
                    <p>{job.company} · {job.location}</p>
                  </div>
                  <p class="role-period">{job.period}</p>
                </article>
              ))
            }
          </div>

          <a class="quiet-action quiet-action--standalone" href="/resume.html">
            Read the complete résumé <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article
          class="view-panel view-panel--credentials"
          data-view-panel="credentials"
          aria-hidden="true"
          inert
        >
          <p class="view-index"><span>04</span> Credentials & skills</p>
          <h2>Technical range,<br />kept practical.</h2>

          <div class="credential-strip" aria-label="Primary certifications">
            {
              primaryCredentials.map((credential, index) => (
                <div>
                  <span>0{index + 1}</span>
                  <strong>{credential.name}</strong>
                </div>
              ))
            }
          </div>

          <div class="skill-index">
            {
              capabilities.map((capability) => (
                <p>
                  <span>{capability.number}</span>
                  {capability.title}
                </p>
              ))
            }
          </div>
        </article>
      </section>

      <figure
        class="portrait-frame"
        data-portrait-frame
        style={`--hero-image: url("${heroPortrait}")`}
      >
        <picture>
          <source media="(max-width: 760px)" srcset={mobilePortrait} />
          <img
            src={heroPortrait}
            alt="Black-and-white portrait of Gary Virk"
            width="1440"
            height="960"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <span class="portrait-detail" aria-hidden="true"></span>
        <span class="portrait-wash" aria-hidden="true"></span>
        <span class="portrait-cursor" aria-hidden="true"><i></i></span>
        <figcaption>
          <span>Portrait / 2026</span>
          <span>Move to inspect</span>
        </figcaption>
      </figure>

      <div class="stage-status" aria-label="Current professional details">
        <p><span>Location</span>{profile.location}</p>
        <p><span>Credentials</span>CCNA · A+ · Network+</p>
      </div>

      <p class="view-counter" aria-hidden="true">
        <span data-current-view>01</span>
        <i></i>
        <span>04</span>
      </p>
    </div>

    <footer class="portrait-footer">
      <p>© 2026 Gary Virk</p>
      <div>
        <a href={profile.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={`mailto:${profile.email}`}>Email <span aria-hidden="true">↗</span></a>
      </div>
      <p>Mississauga · Ontario · Canada</p>
    </footer>
  </main>

  <script src="../scripts/portrait-home.ts"></script>
</BaseLayout>
