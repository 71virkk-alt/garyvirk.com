---
import WorkHeader from "../components/WorkHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import "../styles/work.css";
---

<BaseLayout
  title="Selected IT & Networking Work — Gary Virk"
  description="Five evidence-backed IT support and networking projects covering Windows endpoint diagnostics, access control, inventory drift, DHCP, and packet analysis."
  canonicalPath="/work.html"
  bodyClass="work-page"
  themeColor="#080a0c"
  colorScheme="dark"
>
  <main id="main" class="work-shell">
    <WorkHeader />

    <header class="work-intro">
      <p class="work-kicker"><span>05</span> Controlled labs · independent review</p>
      <h1>Systems work,<br /><em>with receipts.</em></h1>
      <div class="work-intro-copy">
        <p>
          These are small, controlled systems built to answer practical support questions.
          Each one includes a failure, the evidence used to isolate it, a bounded change,
          and a separate check that proves what happened next.
        </p>
        <p class="work-disclosure">
          All environments are owned labs. Production, enterprise, and Windows claims are
          stated only where the evidence supports them.
        </p>
      </div>
    </header>

    <section class="project-index" aria-labelledby="project-index-heading">
      <h2 id="project-index-heading" class="sr-only">Project index</h2>
      {
        projects.map((project) => (
          <a class="project-row" href={`/work/${project.slug}.html`}>
            <p class="project-number">{project.number}</p>
            <div class="project-row-copy">
              <p>{project.discipline}</p>
              <h3>{project.title}</h3>
              <span>{project.summary}</span>
            </div>
            <div class="project-row-result">
              <p><i aria-hidden="true"></i> Validated</p>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        ))
      }
    </section>

    <footer class="work-footer">
      <p>Need the short version?</p>
      <a href="/resume.html">Read the résumé <span aria-hidden="true">↗</span></a>
      <a href="mailto:i@garyvirk.com">i@garyvirk.com</a>
    </footer>
  </main>
</BaseLayout>
