---
import WorkHeader from "../components/WorkHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  flagshipProjects,
  supportingProjects,
  technicalNotes,
  type PortfolioProject
} from "../data/projects";
import "../styles/work.css";

const proofLabel = (project: PortfolioProject) =>
  project.kind === "technical-note"
    ? "Vendor sources and labelled aids"
    : project.status.execution;
---

<BaseLayout
  title="Selected IT Support and Networking Work | Gary Virk"
  description="Executed IT support labs and source-cited troubleshooting notes covering endpoints, hardware, and networks."
  canonicalPath="/work.html"
  bodyClass="work-page"
  themeColor="#080a0c"
  colorScheme="dark"
>
  <main id="main" class="work-shell">
    <WorkHeader />

    <header class="work-intro">
      <p class="work-kicker"><span>Work</span> Executed labs · cited support notes</p>
      <h1>Selected IT support and networking work.</h1>
      <div class="work-intro-copy">
        <p>
          Each lab starts with a fault, shows the evidence used to isolate it, and ends
          with a retest. Technical notes are based on cited vendor guidance and are not
          presented as executed work.
        </p>
        <p class="work-disclosure">
          Employer records are not published. Generated images are labelled and used
          only for explanation.
        </p>
        <dl class="evidence-key" aria-label="Evidence labels used on this site">
          <div>
            <dt>Captured output</dt>
            <dd>Collected during a controlled lab.</dd>
          </div>
          <div>
            <dt>Derived view</dt>
            <dd>Built from captured lab data.</dd>
          </div>
          <div>
            <dt>Technical note</dt>
            <dd>Based on cited vendor guidance.</dd>
          </div>
          <div>
            <dt>Editorial image</dt>
            <dd>Used for explanation, never proof.</dd>
          </div>
        </dl>
      </div>
      <figure class="work-editorial work-editorial--evidence">
        <div
          class="work-evidence-mosaic"
          role="group"
          aria-label="Fault, decisive check, and retest evidence"
        >
          <div>
            <img
              src="/work-assets/evidence/network-access-control/packet-tracer/screenshots/broken-users-https-timeout.png"
              alt="Packet Tracer browser showing the inserted HTTPS timeout"
              width="700"
              height="708"
              loading="eager"
              decoding="async"
            />
            <span>Fault</span>
          </div>
          <div>
            <img
              src="/work-assets/evidence/network-access-control/packet-tracer/screenshots/broken-router-deny-counter.png"
              alt="Packet Tracer router output showing the inserted ACL deny and match counter"
              width="700"
              height="708"
              loading="eager"
              decoding="async"
            />
            <span>Decisive check</span>
          </div>
          <div>
            <img
              src="/work-assets/evidence/network-access-control/packet-tracer/screenshots/corrected-users-https-pass.png"
              alt="Packet Tracer browser showing HTTPS restored after the ACL correction"
              width="700"
              height="708"
              loading="eager"
              decoding="async"
            />
            <span>Retest</span>
          </div>
        </div>
        <figcaption>
          <a href="/work/network-access-control.html">View the ACL case study <i aria-hidden="true">↗</i></a>
        </figcaption>
      </figure>
    </header>

    <section class="work-group" aria-labelledby="flagship-heading">
      <div class="work-group-heading">
        <p>01</p>
        <div>
          <h2 id="flagship-heading">Detailed case studies</h2>
          <span>Troubleshooting and change records with selected public evidence.</span>
        </div>
      </div>
      <div class="project-index project-index--flagship">
        {
          flagshipProjects.map((project) => (
            <a class="project-row" href={`/work/${project.slug}.html`}>
              <p class="project-number">{project.number}</p>
              <div class="project-row-copy">
                <p>{project.discipline}</p>
                <h3>{project.title}</h3>
                <span>{project.summary}</span>
              </div>
              <div class="project-row-result">
                <div>
                  <span>What it shows</span>
                  <p>{project.employerValue}</p>
                  <small>{proofLabel(project)}</small>
                </div>
                <i aria-hidden="true">↗</i>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="work-group work-group--supporting" aria-labelledby="supporting-heading">
      <div class="work-group-heading">
        <p>02</p>
        <div>
          <h2 id="supporting-heading">Supporting labs</h2>
          <span>Shorter endpoint, systems, and network records with clear limits.</span>
        </div>
      </div>
      <div class="project-index">
        {
          supportingProjects.map((project) => (
            <a class="project-row" href={`/work/${project.slug}.html`}>
              <p class="project-number">{project.number}</p>
              <div class="project-row-copy">
                <p>{project.discipline}</p>
                <h3>{project.title}</h3>
                <span>{project.summary}</span>
              </div>
              <div class="project-row-result">
                <div>
                  <span>What it shows</span>
                  <p>{project.employerValue}</p>
                  <small>{proofLabel(project)}</small>
                </div>
                <i aria-hidden="true">↗</i>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="work-group work-group--notes" aria-labelledby="notes-heading">
      <div class="work-group-heading">
        <p>03</p>
        <div>
          <h2 id="notes-heading">Support notes</h2>
          <span>Source-cited troubleshooting paths. These are not executed labs.</span>
        </div>
      </div>
      <div class="project-index project-index--notes">
        {
          technicalNotes.map((project) => (
            <a class="project-row project-row--note" href={`/work/${project.slug}.html`}>
              <p class="project-number">{project.number}</p>
              <div class="project-row-copy">
                <p>{project.discipline}</p>
                <h3>{project.title}</h3>
                <span>{project.summary}</span>
              </div>
              <div class="project-row-result">
                <div>
                  <span>Decision</span>
                  <p>{project.employerValue}</p>
                  <small>{proofLabel(project)}</small>
                </div>
                <i aria-hidden="true">↗</i>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="work-footer">
      <div>
        <p>Looking for my employment history?</p>
        <a href="/resume.html">Read the résumé <span aria-hidden="true">↗</span></a>
      </div>
      <a href="mailto:i@garyvirk.com">i@garyvirk.com</a>
    </footer>
  </main>
</BaseLayout>
