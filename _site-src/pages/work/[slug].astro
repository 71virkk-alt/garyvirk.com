---
import WorkHeader from "../../components/WorkHeader.astro";
import ProjectVisualization from "../../components/ProjectVisualization.astro";
import EvidenceArtifactCard from "../../components/EvidenceArtifactCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  publicProjects,
  selectedProjects,
  type PortfolioProject
} from "../../data/projects";
import "../../styles/work.css";
import "../../styles/work-visualizations.css";

export function getStaticPaths() {
  return publicProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props as { project: PortfolioProject };
const selectedIndex = selectedProjects.findIndex((item) => item.slug === project.slug);
const nextProject =
  selectedIndex >= 0 ? selectedProjects[(selectedIndex + 1) % selectedProjects.length] : undefined;
const isArchived = project.tier === "archived";
const isTechnicalNote = project.kind === "technical-note";
const sourceTitlesById = new Map((project.sources ?? []).map((source) => [source.id, source.title]));
const artifactLabelsById = new Map(
  project.evidence.map((artifact, index) => [
    artifact.id,
    `E${String(index + 1).padStart(2, "0")}`
  ])
);
const sourceLabelsById = new Map(
  (project.sources ?? []).map((source, index) => [
    source.id,
    `S${String(index + 1).padStart(2, "0")}`
  ])
);
const claimLabelsById = new Map(
  project.claims.map((claim, index) => [
    claim.id,
    `C${String(index + 1).padStart(2, "0")}`
  ])
);
const leadClaim = project.claims[0];
const leadArtifactId = leadClaim?.evidenceRefs[0];
const leadSourceId = leadClaim?.sourceRefs?.[0];
const leadReferenceHref = isTechnicalNote
  ? leadSourceId
    ? `#source-${leadSourceId}`
    : "#sources-heading"
  : leadArtifactId
    ? `#evidence-${leadArtifactId}`
    : "#evidence-heading";
const leadReferenceLabel = isTechnicalNote
  ? sourceLabelsById.get(leadSourceId ?? "") ?? "Primary source"
  : artifactLabelsById.get(leadArtifactId ?? "") ?? "Evidence";
const heroBoundary =
  project.limitation.match(/^[^.!?]+[.!?]/)?.[0] ?? project.limitation;
const decisiveEvidence = project.evidence.slice(0, 3);
const archivedEvidence = project.evidence.slice(3);
const projectBodyClass = `work-page project-page project-page--${project.presentation} project-page--${project.kind}`;
---

<BaseLayout
  title={`${project.title} | Gary Virk`}
  description={project.summary}
  canonicalPath={`/work/${project.slug}.html`}
  bodyClass={projectBodyClass}
  themeColor="#080a0c"
  colorScheme="dark"
  noIndex={isArchived}
>
  <main id="main" class="work-shell">
    <WorkHeader />

    {
      isArchived ? (
        <article class="archive-page">
          <p class="work-kicker"><span>Archive</span> Unfeatured project</p>
          <h1>{project.title}</h1>
          <p>{project.summary}</p>
          <p>{project.limitation}</p>
          <a href="/work.html">Return to selected work <span aria-hidden="true">→</span></a>
        </article>
      ) : (
        <article class="case-file">
          <header class="case-hero">
            <a class="case-back" href="/work.html">← All work</a>
            {isTechnicalNote && (
              <aside class="note-disclosure" role="note">
                Technical note, not an executed lab. Built from cited documentation and
                clearly labelled diagrams and worksheets.
              </aside>
            )}
            <p class="work-kicker"><span>{project.number}</span> {project.discipline}</p>
            <h1>{project.title}</h1>
            <p class="case-deck">{project.summary}</p>

            <dl class="case-verdict" aria-label="Case summary">
              <div>
                <dt>Issue</dt>
                <dd>{project.question}</dd>
              </div>
              <div>
                <dt>{isTechnicalNote ? "Basis" : "Decisive evidence"}</dt>
                <dd>
                  {leadClaim?.publicWording ?? project.employerValue}
                  <a href={leadReferenceHref}>
                    {leadReferenceLabel} <span aria-hidden="true">↓</span>
                  </a>
                </dd>
              </div>
              <div>
                <dt>Result</dt>
                <dd>{project.employerValue}</dd>
              </div>
              <div>
                <dt>Boundary</dt>
                <dd>
                  {heroBoundary}
                  <a href="#outcome-heading">Full limit <span aria-hidden="true">↓</span></a>
                </dd>
              </div>
            </dl>

            <dl class="case-status">
              {isTechnicalNote ? (
                <>
                  <div><dt>Type</dt><dd>Source-cited technical note</dd></div>
                  <div><dt>Basis</dt><dd>Official vendor documentation</dd></div>
                  <div><dt>Review</dt><dd>{project.status.review}</dd></div>
                  <div><dt>Visuals</dt><dd>Clearly labelled diagrams and worksheets</dd></div>
                </>
              ) : (
                <>
                  <div><dt>Completion</dt><dd>{project.status.completion}</dd></div>
                  <div><dt>Execution</dt><dd>{project.status.execution}</dd></div>
                  <div><dt>Review</dt><dd>{project.status.review}</dd></div>
                  <div><dt>Evidence</dt><dd>{project.status.publication}</dd></div>
                </>
              )}
            </dl>

            <ul class="case-environment" aria-label="Project environment">
              {project.environment.map((item) => <li>{item}</li>)}
            </ul>

            <nav class="case-jump-links" aria-label="On this page">
              <span>On this page</span>
              <a href="#question-heading">{isTechnicalNote ? "Scenario" : "Question"}</a>
              {project.visualization && <a href={`#${project.slug}-visualization-title`}>Interactive view</a>}
              <a href="#process-heading">{isTechnicalNote ? "Decision path" : "Method"}</a>
              <a href="#evidence-heading">{isTechnicalNote ? "Sources and aids" : "Evidence"}</a>
              <a href="#outcome-heading">Result and limits</a>
            </nav>
          </header>

          <section class="case-question" aria-labelledby="question-heading">
            <p class="section-label">{isTechnicalNote ? "Support scenario" : "The support question"}</p>
            <div>
              <h2 id="question-heading">{project.question}</h2>
              <p class="ownership"><strong>Project record:</strong> {project.ownership}</p>
            </div>
          </section>

          {project.visualization && (
            <ProjectVisualization
              projectSlug={project.slug}
              visualization={project.visualization}
            />
          )}

          {project.presentation === "change" && project.matrix && (
            <section class="change-matrix-section" aria-labelledby="change-matrix-heading">
              <p class="section-label">Change boundary</p>
              <div>
                <h2 id="change-matrix-heading">Required access returned. Closed paths stayed closed.</h2>
                <p class="matrix-scroll-cue">Scroll to compare <span aria-hidden="true">→</span></p>
                <div class="evidence-matrix" role="table" tabindex="0" aria-label={`${project.title} result matrix`}>
                  <div class="matrix-row matrix-head" role="row">
                    <span role="columnheader">Check</span>
                    <span role="columnheader">Inserted fault</span>
                    <span role="columnheader">After correction</span>
                  </div>
                  {project.matrix.map((row) => (
                    <div class="matrix-row" role="row">
                      <strong role="cell">{row.check}</strong>
                      <span role="cell">{row.failure}</span>
                      <span role="cell" class="matrix-pass">{row.corrected}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          {isTechnicalNote && project.matrix && (
            <section class:list={["note-map-section", `note-map-section--${project.presentation}`]} aria-labelledby="note-map-heading">
              <p class="section-label">
                {project.presentation === "macos" ? "Enrollment flow" : project.presentation === "hardware" ? "Fault tree" : "Connection ladder"}
              </p>
              <div>
                <h2 id="note-map-heading">
                  {project.presentation === "macos"
                    ? "Enrollment and encryption are separate decisions."
                    : project.presentation === "hardware"
                      ? "The startup stop point determines the next safe branch."
                      : "Move down the stack until the first failed layer."}
                </h2>

                {project.presentation === "macos" && (
                  <ol class="macos-flow" aria-label="macOS enrollment and encryption decision flow">
                    {project.matrix.map((row, index) => (
                      <li>
                        <span>{String(index + 1).padStart(2, "0")}</span>
                        <div><h3>{row.check}</h3><p>{row.failure}</p><small>{row.corrected}</small></div>
                      </li>
                    ))}
                  </ol>
                )}

                {project.presentation === "hardware" && (
                  <ol class="hardware-tree" aria-label="Laptop startup fault tree">
                    {project.matrix.map((row, index) => (
                      <li>
                        <span class="tree-node">{String(index + 1).padStart(2, "0")}</span>
                        <div><h3>{row.check}</h3><p>{row.failure}</p><small>Next: {row.corrected}</small></div>
                      </li>
                    ))}
                  </ol>
                )}

                {project.presentation === "wifi" && (
                  <ol class="wifi-ladder" aria-label="Enterprise Wi-Fi support layer ladder">
                    {project.matrix.map((row, index) => (
                      <li>
                        <span>{String(index + 1).padStart(2, "0")}</span>
                        <div><h3>{row.check}</h3><p>{row.failure}</p></div>
                        <small>{row.corrected}</small>
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </section>
          )}

          <section class:list={["case-process", `case-process--${project.presentation}`]} aria-labelledby="process-heading">
            <p class="section-label">
              {project.processLabel ?? (isTechnicalNote ? "Support path" : project.presentation === "timeline" ? "Troubleshooting record" : project.presentation === "packet" ? "Packet workflow" : project.presentation === "notes" ? "Method" : "Change sequence")}
            </p>
            <div>
              <h2 id="process-heading">
                {project.processHeading ?? (project.presentation === "timeline" ? "The same checks before and after the change." : project.presentation === "packet" ? "Read the exchange before changing the service." : project.presentation === "notes" ? "Start with the symptom, apply one relevant filter, then capture the post-change result." : "Intent first, then regression, correction, and rollback.")}
              </h2>
              <ol class="process-list">
                {project.approach.map((item, index) => (
                  <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>
                ))}
              </ol>
            </div>
          </section>

          {project.presentation === "timeline" && project.matrix && (
            <section class="compact-matrix" aria-labelledby="timeline-result-heading">
              <p class="section-label">DNS example</p>
              <div>
                <h2 id="timeline-result-heading">Direct TCP stayed up while the name check failed.</h2>
                <p class="matrix-scroll-cue">Scroll to compare <span aria-hidden="true">→</span></p>
                <div class="evidence-matrix" role="table" tabindex="0" aria-label={`${project.title} DNS example`}>
                  <div class="matrix-row matrix-head" role="row">
                    <span role="columnheader">Check</span>
                    <span role="columnheader">Fault</span>
                    <span role="columnheader">Retest</span>
                  </div>
                  {project.matrix.map((row) => (
                    <div class="matrix-row" role="row">
                      <strong role="cell">{row.check}</strong>
                      <span role="cell">{row.failure}</span>
                      <span role="cell" class="matrix-pass">{row.corrected}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          {project.presentation === "notes" && project.notes && (
            <section class="packet-notes" aria-labelledby="packet-notes-heading">
              <p class="section-label">Four notes</p>
              <div>
                <h2 id="packet-notes-heading">Short records for four different symptoms.</h2>
                <div class="notes-list">
                  {project.notes.map((note) => (
                    <details>
                      <summary>{note.title}<span aria-hidden="true">+</span></summary>
                      <dl>
                        <div><dt>Symptom</dt><dd>{note.symptom}</dd></div>
                        <div><dt>Evidence</dt><dd>{note.evidence}</dd></div>
                        <div><dt>Post-change</dt><dd>{note.result}</dd></div>
                        <div><dt>Limit</dt><dd>{note.limitation}</dd></div>
                      </dl>
                    </details>
                  ))}
                </div>
              </div>
            </section>
          )}

          <section class="evidence-section" aria-labelledby="evidence-heading">
            <div class="evidence-heading">
              <p class="section-label">{isTechnicalNote ? "Explanatory aids" : "Evidence from the lab"}</p>
              <div>
                <h2 id="evidence-heading">{project.evidenceHeading ?? "The checks used to reach the conclusion."}</h2>
                <p>
                  {project.evidenceDescription ?? "Selected outputs from the lab. Sensitive and unnecessary details are omitted."}
                </p>
              </div>
            </div>

            <div class="evidence-grid">
              {
                decisiveEvidence.map((artifact) => {
                  const claimId = artifact.claimIds[0];
                  return (
                    <EvidenceArtifactCard
                      artifact={artifact}
                      label={artifactLabelsById.get(artifact.id) ?? artifact.id}
                      isTechnicalNote={isTechnicalNote}
                      claimHref={claimId ? `#claim-${claimId}` : undefined}
                      claimLabel={claimId ? claimLabelsById.get(claimId) : undefined}
                    />
                  );
                })
              }
            </div>

            {
              archivedEvidence.length > 0 && (
                <details class="evidence-archive">
                  <summary>
                    <span>Full evidence archive</span>
                    <small>{archivedEvidence.length} additional {archivedEvidence.length === 1 ? "artifact" : "artifacts"}</small>
                    <i aria-hidden="true">+</i>
                  </summary>
                  <div class="evidence-grid evidence-grid--archive">
                    {archivedEvidence.map((artifact) => {
                      const claimId = artifact.claimIds[0];
                      return (
                        <EvidenceArtifactCard
                          artifact={artifact}
                          label={artifactLabelsById.get(artifact.id) ?? artifact.id}
                          isTechnicalNote={isTechnicalNote}
                          claimHref={claimId ? `#claim-${claimId}` : undefined}
                          claimLabel={claimId ? claimLabelsById.get(claimId) : undefined}
                        />
                      );
                    })}
                  </div>
                </details>
              )
            }
          </section>

          {project.sources && project.sources.length > 0 && (
            <section class="source-section" aria-labelledby="sources-heading">
              <p class="section-label">Primary sources</p>
              <div>
                <h2 id="sources-heading">Guidance used for this note.</h2>
                <div class="source-list">
                  {project.sources.map((source) => (
                    <a id={`source-${source.id}`} href={source.url} rel="noopener">
                      <span>{source.publisher}</span>
                      <strong>{source.title}</strong>
                      <p>{source.supports}</p>
                      <i aria-hidden="true">↗</i>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )}

          <section class="case-outcome" aria-labelledby="outcome-heading">
            <p class="section-label">Result and limits</p>
            <div>
              <h2 id="outcome-heading">{isTechnicalNote ? "What this note supports, and what it does not claim." : "What changed, and what this lab does not prove."}</h2>
              <div class="outcome-grid">
                <article>
                  <h3>{isTechnicalNote ? "Supports" : "Result"}</h3>
                  <p>{project.outcome}</p>
                </article>
                <article>
                  <h3>Limit</h3>
                  <p>{project.limitation}</p>
                </article>
              </div>
            </div>
          </section>

          <section class="claim-list" aria-labelledby="claims-heading">
            <p class="section-label">{isTechnicalNote ? "Sources" : "Claims and evidence"}</p>
            <div>
              <h2 id="claims-heading">{isTechnicalNote ? "Each conclusion points back to a cited source." : "What the evidence supports."}</h2>
              <div>
                {project.claims.map((claim) => (
                  <article id={`claim-${claim.id}`}>
                    <strong>{claim.publicWording}</strong>
                    <p>{claim.limitation}</p>
                    <span class="claim-reference-list">
                      {isTechnicalNote ? "Sources" : "Evidence"}
                      {
                        isTechnicalNote
                          ? (claim.sourceRefs ?? []).map((sourceId) => (
                              <a href={`#source-${sourceId}`} title={sourceTitlesById.get(sourceId)}>
                                {sourceLabelsById.get(sourceId) ?? sourceId}
                              </a>
                            ))
                          : claim.evidenceRefs.map((artifactId) => (
                              <a href={`#evidence-${artifactId}`}>
                                {artifactLabelsById.get(artifactId) ?? artifactId}
                              </a>
                            ))
                      }
                    </span>
                  </article>
                ))}
              </div>
            </div>
          </section>

          {nextProject && (
            <nav class="next-case" aria-label="Next case study">
              <p>Next case · {nextProject.number}</p>
              <a href={`/work/${nextProject.slug}.html`}>
                {nextProject.title} <span aria-hidden="true">→</span>
              </a>
            </nav>
          )}
        </article>
      )
    }
  </main>
  <script src="../../scripts/project-visualizations.ts"></script>
</BaseLayout>
