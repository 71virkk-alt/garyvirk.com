---
import { profile } from "../data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={["site-header", { "site-header--compact": compact }]} data-site-header>
  <a class="brand" href="/" aria-label="Gary Virk, home">
    <span class="brand-copy">
      <span class="brand-name">{profile.name}</span>
      <span class="brand-discipline">{profile.role}</span>
    </span>
  </a>

  <nav class="header-actions" aria-label={compact ? "Résumé navigation" : "Primary navigation"}>
    <a class="nav-link" href="/">Home</a>
    <a class="nav-link" href="/work.html">Work</a>
    <a class="button button--small button--ink" href={`mailto:${profile.email}`}>Email Gary</a>
  </nav>
</header>
